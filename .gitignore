*.tsbuildinfo
next-env.d.ts

.vercel
.claude/

# 크론 스냅샷은 data 브랜치에 산다 (배포예산 — coin-track.yml 참조)
data/coin-signals.json

# 핸드오프 문서 — 커밋 금지(public 저장소)
*.pdf

# 로컬 전용 프로젝트 진행 기록(다른 도구가 관리) — 저장소에 올리지 않음
project-state.json
.redesign-preview/

# BNF 연구 원본 데이터 캐시(scripts/bnf-fetch.ts) — 재현 가능·용량 큼, 저장소엔 manifest 만
/.bnf-data/
# BNF 모의 검증 기록 — bnf-forward 브랜치에 산다(.github/workflows/bnf-forward.yml)
data/bnf-forward.json
